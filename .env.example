POSTGRES_PASSWORD=replace-with-a-random-password
MINIO_ROOT_USER=flopwire
MINIO_ROOT_PASSWORD=replace-with-a-random-password
FLOPWIRE_PORT=8080
# TLS: auto (self-signed, or ACME when FLOPWIRE_DOMAIN is set), self-signed,
# acme, or proxy (plain HTTP behind your own TLS-terminating proxy).
FLOPWIRE_TLS=auto
FLOPWIRE_DOMAIN=
FLOPWIRE_ACME_EMAIL=
# Only list the reverse proxy network. flopwire ignores forwarded IP headers from
# every other peer.
FLOPWIRE_TRUSTED_PROXY_CIDRS=
FLOPWIRE_AUTH_RATE_BURST=10
FLOPWIRE_AUTH_RATE_REFILL=1m

# Pause between background parser/rule refreshes. Reads prioritize stale sessions.
# FLOPWIRE_REPARSE_INTERVAL=2s

# Message bus: days to keep delivered, read, expired, refused and undelivered
# messages after their 24-hour expiry, with their audit rows. A duration
# (168h) or days (7d); at least 1h. See docs/runbook.md.
# FLOPWIRE_BUS_RETENTION=7d
