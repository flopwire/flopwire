{
  "description": "flopwire hook: prints the standing instruction and pending messages into the session, tells the device agent when the session ends, and asks it to index the transcript",
  "hooks": {
    "SessionStart": [
      { "hooks": [{ "type": "command", "command": "/bin/sh \"${PLUGIN_ROOT}/bin/flopwire-hook\" hook", "timeout": 5 }] }
    ],
    "UserPromptSubmit": [
      { "hooks": [{ "type": "command", "command": "/bin/sh \"${PLUGIN_ROOT}/bin/flopwire-hook\" hook", "timeout": 5 }] }
    ],
    "PostToolUse": [
      { "matcher": "*", "hooks": [{ "type": "command", "command": "/bin/sh \"${PLUGIN_ROOT}/bin/flopwire-hook\" hook", "timeout": 5 }] }
    ],
    "Stop": [
      { "hooks": [{ "type": "command", "command": "/bin/sh \"${PLUGIN_ROOT}/bin/flopwire-hook\" hook", "timeout": 5, "async": true }] }
    ],
    "SessionEnd": [
      { "hooks": [{ "type": "command", "command": "/bin/sh \"${PLUGIN_ROOT}/bin/flopwire-hook\" hook", "timeout": 3 }] }
    ]
  }
}
